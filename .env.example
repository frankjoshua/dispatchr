# How dispatchr reaches rostr. Copy to .env; never commit .env. Set one of the two:

# Direct, as yourself: rostr's tailnet address (behind `tailscale serve`). Each viewer sees what their
# own Tailscale login's grants allow; rostr must list dispatchr's origins in ROSTR_CORS_ORIGINS.
VITE_ROSTR_URL=

# Through a token (when VITE_ROSTR_URL is empty): the dev server proxies to rostr and adds this token
# (a viewer token is enough); everyone sees what it sees. E.g. ROSTR_URL=https://rostr.example.net
ROSTR_URL=
ROSTR_TOKEN=

# Optional: host names the dev server is reached by through a proxy, comma-separated
# (e.g. the machine's tailnet name when shared with `tailscale serve`).
DISPATCHR_ALLOWED_HOSTS=
